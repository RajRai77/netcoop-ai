{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netcoop:ndep:source-profile:1.0.0",
  "title": "NDEP SourceProfile v1.0.0 (draft) - declared mapping from a vendor format to NDEP",
  "description": "Every field mapping and unit is declared by the profile author. Nothing is inferred from column names or values. Columns not declared are reported as UNMAPPED_FIELD.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "version", "format", "source", "record_id", "timestamp", "subject", "measurements"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "format": {"enum": ["csv", "json-records"]},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "data_mode", "source_type"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "data_mode": {"enum": ["synthetic", "recorded", "emulated", "live", "mock"]},
        "source_type": {"type": "string", "minLength": 1}
      }
    },
    "record_id": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["field"], "properties": {"field": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["derive"], "properties": {"derive": {"const": "content"}}}
      ]
    },
    "timestamp": {
      "type": "object", "additionalProperties": false, "required": ["field"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "pattern": "^(Z|[+-][0-9]{2}:[0-9]{2})$", "description": "Declared offset applied ONLY to values without one."}
      }
    },
    "origin_sample_field": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "device_id": {"type": "string"}, "interface_id": {"type": "string"}, "service_id": {"type": "string"},
        "segment_id": {"type": "string"}, "link_id": {"type": "string"}
      }
    },
    "measurements": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["metric", "unit"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "kind": {"enum": ["gauge", "cumulative_counter", "derived_rate", "interval_summary", "state"]}
        }
      }
    },
    "ignore_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}

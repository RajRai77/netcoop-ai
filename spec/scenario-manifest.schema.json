{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netcoop:scenario-manifest:1.1.0",
  "title": "Scenario source manifest (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "data_mode",
    "source_description",
    "telemetry_file",
    "topology_file",
    "ground_truth_file",
    "time_window",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "data_mode": {
      "enum": [
        "synthetic",
        "recorded",
        "emulated",
        "live",
        "mock"
      ]
    },
    "source_description": {
      "type": "string",
      "minLength": 1
    },
    "telemetry_file": {
      "type": "string"
    },
    "topology_file": {
      "type": "string"
    },
    "ground_truth_file": {
      "type": "string"
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "seed": {
      "type": "integer"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "archive_file": {
      "type": [
        "string",
        "null"
      ],
      "description": "Recorded observations NOT in the initial upload; agents may query it for verification (recorded_replay)."
    },
    "reference_time": {
      "type": "string",
      "format": "date-time",
      "description": "Capture time; freshness is judged against it."
    },
    "telemetry_profile": {
      "type": [
        "string",
        "null"
      ],
      "description": "Source profile id when telemetry_file is vendor CSV/JSON."
    },
    "split": {
      "enum": [
        "dev",
        "heldout",
        "organizer"
      ],
      "description": "'organizer' = scenarios built from the organizer's sample generator (PS section 5); not part of the dev or held-out accuracy sets."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generator": {
      "type": "object"
    }
  }
}

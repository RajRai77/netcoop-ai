{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netcoop:ndep:finding:1.0.0",
  "title": "NDEP Finding v1.0.0 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "incident_id",
    "agent_id",
    "claim",
    "polarity",
    "subject",
    "observation_refs",
    "rule_or_model_version",
    "created_at",
    "caveats"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "polarity": {
      "enum": [
        "present",
        "absent",
        "unknown"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "interface_id": {
          "type": "string",
          "minLength": 1
        },
        "service_id": {
          "type": "string",
          "minLength": 1
        },
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "link_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "device_id"
          ]
        },
        {
          "required": [
            "service_id"
          ]
        },
        {
          "required": [
            "segment_id"
          ]
        },
        {
          "required": [
            "link_id"
          ]
        }
      ]
    },
    "observation_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule_or_model_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes_finding_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

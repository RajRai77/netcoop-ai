{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netcoop:ndep:observation:1.0.0",
  "title": "NDEP NormalizedObservation v1.0.0 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "incident_id",
    "raw_record_ref",
    "source",
    "subject",
    "measurement",
    "observed_at",
    "ingested_at",
    "quality",
    "lineage_group",
    "metric_registry_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_record_ref": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "data_mode",
        "source_type"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "data_mode": {
          "enum": [
            "synthetic",
            "recorded",
            "emulated",
            "live",
            "mock"
          ]
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "interface_id": {
          "type": "string",
          "minLength": 1
        },
        "service_id": {
          "type": "string",
          "minLength": 1
        },
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "link_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "device_id"
          ]
        },
        {
          "required": [
            "service_id"
          ]
        },
        {
          "required": [
            "segment_id"
          ]
        },
        {
          "required": [
            "link_id"
          ]
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "value",
        "unit",
        "kind"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "gauge",
            "cumulative_counter",
            "derived_rate",
            "interval_summary",
            "state"
          ]
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation",
        "freshness",
        "flags"
      ],
      "properties": {
        "validation": {
          "enum": [
            "passed",
            "quarantined",
            "rejected"
          ]
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lineage_group": {
      "type": "string",
      "minLength": 1
    },
    "metric_registry_version": {
      "type": "string",
      "minLength": 1
    },
    "transformation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

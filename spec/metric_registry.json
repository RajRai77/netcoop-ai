    "link_utilization": {
      "canonical_unit": "percent",
      "allowed_units": [
        "percent"
      ],
      "min": 0,
      "max": 100
    },
    "packet_loss": {
      "canonical_unit": "percent",
      "allowed_units": [
        "percent"
      ],
      "min": 0,
      "max": 100,
      "caution": "ratio->percent only with an explicitly declared source schema"
    },
    "latency": {
      "canonical_unit": "ms",
      "allowed_units": [
        "ms",
        "s"
      ],
      "min": 0
    },
    "jitter": {
      "canonical_unit": "ms",
      "allowed_units": [
        "ms",
        "s"
      ],
      "min": 0
    },
    "throughput": {
      "canonical_unit": "bit/s",
      "allowed_units": [
        "bit/s",
        "kbit/s",
        "Mbit/s"
      ],
      "min": 0
    },
    "cpu_utilization": {
      "canonical_unit": "percent",
      "allowed_units": [
        "percent"
      ],
      "min": 0,
      "max": 100
    },
    "crc_errors": {
      "canonical_unit": "count",
      "allowed_units": [
        "count"
      ],
      "min": 0,

      "allowed_units": [
        "dB"
      ]
    },
    "device_status": {
      "canonical_unit": "state",
      "allowed_units": [
        "state"
      ],
      "allowed_values": [
        "up",
        "down",
        "degraded",
        "unknown"
      ],

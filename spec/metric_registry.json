      "allowed_units": [
        "percent"
      ],
      "min": 0,
      "max": 100
    },
    "dhcp_lease_failure_rate": {
      "canonical_unit": "percent",
      "allowed_units": [
        "percent"
      ],
      "min": 0,
      "max": 100

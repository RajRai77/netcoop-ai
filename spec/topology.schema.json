{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netcoop:topology:1.1.0",
  "title": "Network topology snapshot v1.1.0 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topology_snapshot_id",
    "kind",
    "observed_at",
    "nodes",
    "links",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "topology_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "intended",
        "observed",
        "modeled",
        "synthetic"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "device",
              "service",
              "ap",
              "segment",
              "host"
            ]
          },
          "role": {
            "enum": [
              "core",
              "distribution",
              "access",
              "edge",
              "server",
              "client"
            ],
            "description": "Optional. Nodes with role 'core' are the upstream roots for impact-scope computation."
          },
          "label": {
            "type": "string"
          },
          "service_kind": {
            "enum": [
              "dns",
              "dhcp",
              "aaa",
              "web",
              "other"
            ],
            "description": "For type=service: which service it provides (lets the engine localize DNS vs DHCP faults)."
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "physical",
              "logical",
              "dependency",
              "routing"
            ]
          },
          "directed": {
            "type": "boolean"
          },
          "from_interface": {
            "type": "string",
            "minLength": 1,
            "description": "Interface on the 'from' device carrying this link."
          },
          "to_interface": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netcoop:topology:1.0.0",
  "title": "Network topology snapshot (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topology_snapshot_id",
    "kind",
    "observed_at",
    "nodes",
    "links",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "topology_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "intended",
        "observed",
        "modeled",
        "synthetic"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "device",
              "service",
              "ap",
              "segment",
              "host"
            ]
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "physical",
              "logical",
              "dependency",
              "routing"
            ]
          },
          "directed": {
            "type": "boolean"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

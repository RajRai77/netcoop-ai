# Copy to .env and fill in. NEVER commit .env. Placeholders only below.

# PostgreSQL credentials used by both the db and web containers.
POSTGRES_USER=netcoop
POSTGRES_DB=netcoop
# Required. Generate e.g. with: openssl rand -hex 32  (hex avoids URL-escaping issues)
POSTGRES_PASSWORD=change-me

# Authentication mode (docs/27_AUTHENTICATION.md): clerk | token | none.
#   clerk = Google sign-in via Clerk (hosted multi-user); token = one static bearer token (CI/CLI/Compose);
#   none  = local development only (refused when NETCOOP_ENV=production).
# Unset: "token" if NETCOOP_API_TOKEN is set, otherwise "none".
NETCOOP_AUTH_MODE=

# token mode only: bearer token for /api/* (ignored in clerk mode). Generate e.g. with: openssl rand -hex 32
NETCOOP_API_TOKEN=

# clerk mode. The PUBLISHABLE key (pk_...) is public and is compiled into the React build (build arg / build env).
# The SECRET key (sk_...) is runtime-only: never put it in a VITE_* variable, a Docker build arg or the repository.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: networkless verification with the instance's PEM public key instead of fetching JWKS with the secret key.
# CLERK_JWT_KEY=
# Origins allowed as the session token's authorized party. Default: RENDER_EXTERNAL_URL + NETCOOP_CORS_ORIGINS.
# CLERK_AUTHORIZED_PARTIES=https://your-app.onrender.com

# Shared secret between the coordinator (web) and the specialist agents (REQUIRED by compose).
# Generate e.g. with: openssl rand -hex 32. The local launcher generates its own per run.
NETCOOP_AGENT_TOKEN=change-me-agent-token

# Label shown in health output: development | production
NETCOOP_ENV=development

# Host port for the web container in development (bound to 127.0.0.1 only).
NETCOOP_WEB_PORT=8000

# Production only (compose.production.yaml): public hostname and ACME contact.
NETCOOP_DOMAIN=netcoop.example.org
ACME_EMAIL=admin@example.org

# Local (no Docker) runs: scripts/run_local.py uses SQLite in ./var by default.
# To point the local launcher or CLI at another database instead:
# NETCOOP_DATABASE_URL=sqlite:///var/netcoop.db

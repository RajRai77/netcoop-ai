# Copy to .env and fill in. NEVER commit .env. Placeholders only below.

# PostgreSQL credentials used by both the db and web containers.
POSTGRES_USER=netcoop
POSTGRES_DB=netcoop
# Required. Generate e.g. with: openssl rand -hex 32  (hex avoids URL-escaping issues)
POSTGRES_PASSWORD=change-me

# Label shown in health output: development | production
NETCOOP_ENV=development

# Host port for the web container in development (bound to 127.0.0.1 only).
NETCOOP_WEB_PORT=8000

# Production only (compose.production.yaml): public hostname and ACME contact.
NETCOOP_DOMAIN=netcoop.example.org
ACME_EMAIL=admin@example.org

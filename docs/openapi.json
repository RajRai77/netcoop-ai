{
 "components": {
  "schemas": {
   "CreateIncident": {
    "additionalProperties": false,
    "properties": {
     "data_mode": {
      "anyOf": [
       {
        "enum": [
         "synthetic",
         "recorded",
         "emulated",
         "live",
         "mock"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Data Mode"
     },
     "reference_time": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Capture time used as freshness reference",
      "title": "Reference Time"
     },
     "scenario_id": {
      "anyOf": [
       {
        "maxLength": 120,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Scenario Id"
     },
     "title": {
      "anyOf": [
       {
        "maxLength": 500,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Title"
     },
     "topology": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Topology"
     }
    },
    "title": "CreateIncident",
    "type": "object"
   },
   "DiagnoseRequest": {
    "additionalProperties": false,
    "properties": {
     "max_rounds": {
      "default": 2,
      "maximum": 5.0,
      "minimum": 0.0,
      "title": "Max Rounds",
      "type": "integer"
     },
     "total_budget": {
      "default": 6,
      "maximum": 20.0,
      "minimum": 0.0,
      "title": "Total Budget",
      "type": "integer"
     },
     "verification": {
      "default": true,
      "title": "Verification",
      "type": "boolean"
     }
    },
    "title": "DiagnoseRequest",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
 },

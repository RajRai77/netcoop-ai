# syntax=docker/dockerfile:1
# Single-container image for hosts that run ONE web service (e.g. Render): four processes in one container.
#   web/coordinator API on 0.0.0.0:$PORT  +  three specialist A2A agents on 127.0.0.1 (dynamic ports, never exposed)
# The built React app is served by the API process at / (same origin). PostgreSQL comes from NETCOOP_DATABASE_URL.
# The Compose stack (Dockerfile + compose*.yaml) remains the reference multi-container deployment.

FROM node:22-bookworm-slim AS ui
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# Same-origin build: the app calls /api on the host that served it.
RUN npm run build

FROM python:3.12-slim-bookworm AS build
COPY --from=ghcr.io/astral-sh/uv:0.11.24 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY README.md ./
COPY spec ./spec
COPY src ./src
RUN uv sync --locked --no-dev --no-editable

FROM python:3.12-slim-bookworm AS runtime
RUN groupadd --system app && useradd --system --gid app --home-dir /app app \
    && mkdir -p /app/var && chown -R app:app /app/var
WORKDIR /app
COPY --from=build --chown=app:app /app/.venv /app/.venv
COPY --chown=app:app data/scenarios /app/data/scenarios
COPY --chown=app:app eval /app/eval
COPY --from=ui --chown=app:app /ui/dist /app/frontend-dist
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 \
    NETCOOP_HOST=0.0.0.0 NETCOOP_DATA_DIR=/app/var \
    NETCOOP_SCENARIOS_DIR=/app/data/scenarios NETCOOP_EVAL_DIR=/app/eval \
    NETCOOP_FRONTEND_DIST=/app/frontend-dist NETCOOP_TASK_TIMEOUT_S=60 NETCOOP_LOG_MEMORY_S=300
USER app
EXPOSE 10000
HEALTHCHECK --interval=15s --timeout=3s --start-period=40s --retries=3 \
  CMD ["python", "-c", "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/health/live' % os.environ.get('PORT','10000'), timeout=2).status == 200 else 1)"]
# The launcher applies migrations, starts the agents on loopback, then the API on $PORT, and exits non-zero
# if any of the four processes dies (so the platform restarts the container).
CMD ["python", "-c", "import sys; from netcoop.launcher import main; sys.exit(main())"]
